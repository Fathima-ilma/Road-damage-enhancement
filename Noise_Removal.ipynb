import cv2
import os
import numpy as np
from matplotlib import pyplot as plt

input_folder = "grayscale_frames"
denoised_folder = "denoised_checked"

os.makedirs(denoised_folder, exist_ok=True)

def sharpen_image(image):
    kernel = np.array([[0, -0.5, 0],
                       [-0.5, 3, -0.5],
                       [0, -0.5, 0]])
    return cv2.filter2D(image, -1, kernel)

def detect_noise(gray):
    blurred = cv2.GaussianBlur(gray, (5,5), 0)
    residual = gray - blurred
    std = np.std(residual)
    mean = np.mean(residual)
    skewness = np.mean((residual - np.mean(residual))**3) / (np.std(residual)**3 + 1e-8)
    
    if np.sum((gray==0) | (gray==255)) > 0.02*gray.size:
        return "Impulse"
    elif std < 3 and mean < 2:
        return "Compression"
    elif abs(skewness) < 0.5 and std > 0.5:
        return "Gaussian"
    elif std < 5 and skewness < 0.5:
        return "Uniform"
    elif skewness > 0.5 and mean > 5:
        return "Rayleigh"
    elif skewness > 0.8:
        return "Gamma/Exponential"
    else:
        return "No significant noise"

def denoise_frame(gray, noise_type):
    if noise_type == "Gaussian":
        denoised = cv2.bilateralFilter(gray, 7, 50, 50)
    elif noise_type == "Uniform":
        denoised = cv2.fastNlMeansDenoising(gray, None, h=5, templateWindowSize=7, searchWindowSize=21)
    elif noise_type == "Rayleigh":
        denoised = cv2.fastNlMeansDenoising(gray, None, h=7, templateWindowSize=7, searchWindowSize=21)
    elif noise_type == "Gamma/Exponential":
        denoised = cv2.fastNlMeansDenoising(gray, None, h=8, templateWindowSize=7, searchWindowSize=21)
    elif noise_type == "Impulse":
        denoised = cv2.medianBlur(gray, 3)
    elif noise_type == "Compression":
        denoised = cv2.fastNlMeansDenoising(gray, None, h=3, templateWindowSize=7, searchWindowSize=21)
    else:
        denoised = gray
    denoised = sharpen_image(denoised)
    return denoised

example_frame = None

for filename in sorted(os.listdir(input_folder)):
    img_path = os.path.join(input_folder, filename)
    gray = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)
    if gray is None:
        continue
    
    noise_type = detect_noise(gray)
    denoised = denoise_frame(gray, noise_type)
    
    cv2.imwrite(os.path.join(denoised_folder, filename), denoised)
    
    if filename == "frame_0000.png":   # <-- display histogram only for this frame
        example_frame = (gray, denoised, noise_type, filename)

if example_frame is not None:
    gray, denoised, noise_type, filename = example_frame
    
    plt.figure(figsize=(12,5))
    
    plt.subplot(1,2,1)
    plt.hist(gray.ravel(), bins=256)
    plt.title(f"{filename} - Original Gray Histogram")
    plt.xlabel("Pixel Intensity")
    plt.ylabel("Frequency")
    
    plt.subplot(1,2,2)
    plt.hist(denoised.ravel(), bins=256)
    plt.title(f"{filename} - Denoised Histogram")
    plt.xlabel("Pixel Intensity")
    plt.ylabel("Frequency")
    
    plt.tight_layout()
    plt.show()
